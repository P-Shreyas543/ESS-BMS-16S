	(text "Differential: R_K1 + R_K2 (2 x 10R), C_K1 100nF.\nfc = 1 / (2pi x 20R x 105nF) = 76 kHz (calc).\nC_K2 / C_K3 10nF: common-mode to GND_PWR.\nD_TVS_SHUNT1: bidirectional clamp across the pair."
		(exclude_from_sim no)
		(at 142.24 163.83 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "22b8d934-ef13-4f8f-9140-c5b5f837c53d")
	)
	(text "V_TH_OCP = 3.3 V x 100k / (4.7k + 100k) = 3.15 V (calc).\nOCP_TRIP_N goes low when ADC_I_SENSE > V_TH_OCP; D_OCP1 lights.\nTrip current depends on the external shunt: owner question.\nSHDN tied to +3V3; no latch (MCU + LED only): owner questions."
		(exclude_from_sim no)
		(at 245.11 135.89 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "3c111eaa-8951-4d5b-a34b-f1e7e614f2b0")
	)
