			(color 0 0 132 1)
		)
		(fill
			(type none)
		)
		(uuid "71ddb36a-e4fc-48d2-97da-c381ba69992b")
	)
	(text "Kelvin filters"
		(exclude_from_sim no)
		(at 93.98 62.23 0)
		(effects
			(font
				(size 1 1)
				(bold yes)
				(color 0 0 132 1)
			)
			(justify left top)
		)
		(uuid "77ed5b28-8e42-4dfa-a9b5-4ec4cd627453")
	)
	(text "ISENSE_OUT = 1.65 V + 2.0 mV/A (G 20, REF1 = VS, REF2 = GND).\nLinear −800…+725 A; gain error 0.20 % (INA240 DS p.5).\nR419 100 Ω: B2B load isolation (C_load ≤ 1 nF)."
		(exclude_from_sim no)
		(at 193.04 100.33 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "75a9e436-dc4b-4643-845b-5553e4b93566")
	)
