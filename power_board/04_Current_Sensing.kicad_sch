	)
	(text "Bias 10 k from +3V3_A on sheet 10 (R1013):\n1.65 V at 25 °C over the B2B.\nPCB: RT401 on GND_PWR copper at the shunt pads."
		(exclude_from_sim no)
		(at 283.21 83.82 0)
