	(label "04_CLR_N"
		(at 158.75 163.83 180)
		(fields_autoplaced yes)
		(effects
			(font
				(size 0.8 0.8)
			)
			(justify right bottom)
		)
		(uuid "e210822c-c5d7-45f1-a245-286743aac560")
	)
	(text "R401 ∥ R402 = 100 µΩ: 2.0 W each at 200 A = 40 % of 5 W.\nKelvin taps at the inner pad edges (KB = BAT- side, KP = PACK- side).\nNT401 = the only BAT- / GND_PWR joint (Kelvin edge, R1-09).\nPCB: mirror-symmetric copper to both shunts (current sharing)."
		(exclude_from_sim no)
		(at 27.94 100.33 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "9e2bfb3b-ed4b-4c03-b84b-5959dd4937df")
	)
	(rectangle
		(start 17.78 60.96)
		(end 91.44 107.95)
		(stroke
			(width 0.254)
			(type dash)
			(color 0 0 132 1)
		)
		(fill
			(type none)
		)
		(uuid "b418b9c0-44fc-4786-9589-db3420f235f9")
	)
	(text "Shunt + Kelvin taps"
		(exclude_from_sim no)
		(at 19.05 62.23 0)
		(effects
			(font
				(size 1 1)
				(bold yes)
				(color 0 0 132 1)
			)
			(justify left top)
		)
		(uuid "17d4b29a-0de9-4c7c-8344-838330ffeacf")
	)
	(text "BQ: 2 × 20 Ω per leg (10 Ω) + 100 Ω at the BQ (sheet 02) → τ 22 µs.\nINA: 2 × 10 Ω per leg (5 Ω) + 22 nF → τ = 10 Ω × 22 nF = 0.22 µs.\nPCB: each Kelvin pair as a tight pair from the sense pads."
		(exclude_from_sim no)
		(at 97.79 99.06 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "1e53ccda-2f2a-4c7e-aba7-edbae5ff07c2")
	)
	(rectangle
		(start 92.71 60.96)
