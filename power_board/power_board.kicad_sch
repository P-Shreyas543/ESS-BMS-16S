	(rectangle (start 38.1 85.09) (end 226.06 107.95) (stroke (width 0.254) (type dash) (color 0 0 132 1)) (fill (type none)) (uuid "37912395-5d3d-4f32-877f-af914be8f51d"))
	(text "Power board - sheets and B2B" (exclude_from_sim no) (at 39.370000000000005 86.36 0) (effects (font (size 1 1) (bold yes) (color 0 0 132 1)) (justify left top)) (uuid "6aedadf8-47ab-4bbe-83eb-438b1b65e27c"))
	(text "04 Current Sensing - shunt (Kelvin SHUNT_K_BAT / _PACK), ISENSE_OUT, overcurrent latch -> OC_TRIP_N_PB,\n      OC_CLR, NTC_SHUNT, NT401 = the single BAT- / GND_PWR tie.\n07 Power Stage - CHG / DSG FET banks, pre-charge, PACK / BAT clamps, kill logic U701-U703,\n      heater FET, B- / B+ / PACK lugs, F701 supply-tap fuse, MH701-MH706 on CHASSIS.\nB2B: J701 (sheet 07, female) = J206 (control sheet 02, male), 2 x 15, pin n <-> pin n.\n      In: +3V3, +3V3_A, +12V, GND_PWR, AFE gate drives, FET_EN, MCU_NRST, AFE_FLT_*_N, OC_CLR, HEATER_EN.\n      Out: VSUP_TAP (F701), SHUNT_K_*, ISENSE_OUT, NTC_FET, NTC_SHUNT, OC_TRIP_N, AFE_DFETOFF, KILL_N." (exclude_from_sim no) (at 41.91 91.44 0) (effects (font (size 1 1)) (justify left top)) (uuid "1a5b9b62-f2fa-4331-84fc-46e89383db6a"))
