	(text "ISOLATED 5 V - U4 B0505S-1WR3 (+5V to +5V_ISO)"
		(exclude_from_sim no)
		(at 223.52 146.05 0)
		(effects
			(font
				(size 1 1)
				(bold yes)
				(color 0 0 132 1)
			)
			(justify left top)
		)
		(uuid "1bfc4b81-2c31-4422-9b5b-32026d5b5b50")
	)
	(text "+5V_ISO / GND_ISO supply the comms side only.\nNever join GND_ISO to GND_PWR (isolation barrier).\nSymbol / footprint: Murata CRE1; part: Mornsun."
		(exclude_from_sim no)
		(at 224.79 186.69 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "1f5a3f03-d4f5-44b6-a670-87b66c27d564")
	)
	(text "VOUT = 1.20 V x (1 + R2/R3) = 12.1 V (plan, ref not DS-checked).\nEN/UVLO tied to VIN (no UVLO divider); R1 sets on-time.\nC_FF1 = feed-forward cap across R2.\nPWR_PGOOD: pull-up R_PG1 only, used nowhere else."
		(exclude_from_sim no)
		(at 101.6 118.11 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "3fc4dc9c-83a3-4692-b452-67759d979f79")
	)
	(text "F1 2.5 A fuse first, then D1 TVS to GND_PWR.\nD2 SS310 in series: reverse-polarity block.\nD1 polarity / type: see owner question."
		(exclude_from_sim no)
		(at 38.1 118.11 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "54b7a519-3651-41a6-ac31-3e06dd8b500f")
	)
	(text "+12V BUCK - U1 LM5164-Q1, L1 47uH (V_IN_BUCK to +12V)"
		(exclude_from_sim no)
		(at 100.33 77.47 0)
