	(text "C_VDD1-3 100nF on VDD pins 24 / 36 / 48; VBAT (pin 1) on +3V3, no own cap.\nVDDA and VREF+ on +3V3_A = +3V3 through FB1 600R bead, C_A1 1uF + C_A2 100nF.\nY1 8 MHz, C_X1 / C_X2 18 pF to GND_PWR (Y1 load capacitance not checked).\nAs drawn, owner question: AFE_SDA on PB7 and PB9; PB6 = AFE_SCL."
		(exclude_from_sim no)
		(at 165.1 187.96 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "057ce19c-9986-4feb-b64e-619f4fc9a457")
	)
	(text "Pin 1 = +3V3 (probe sense), 3 / 5 / 9 = GND, 10 = NRST.\nPins 6 (SWO), 7, 8 not connected."
		(exclude_from_sim no)
		(at 273.05 93.98 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "07e55d19-7a83-4dce-a034-854b628c7c31")
	)
