	(text "SPI1 ≤ 20 MHz, mode 0 (FRAM 40 MHz, flash 133 MHz max). R1003 / R1004: PCB next to U301.\nCS PU 4.7 k vs ROM SPI1_NSS PD (25 k min): 3.3 × 25/29.7 = 2.78 V > VIH 2.31 V (R3-09).\nWP / HOLD tied to +3V3 (FRAM WP must be tied to VDD if unused, 001-90865 p.3).\nFlash: GD25Q64ESIG primary, MX25L6433F alternate (FW accepts both JEDEC IDs)."
		(exclude_from_sim no)
		(at 17.78 160.02 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "4844733f-6e31-4af8-9c44-99fc1bdd0ddb")
	)
	(rectangle
		(start 15.24 53.34)
		(end 116.84 167.64)
		(stroke
			(width 0.254)
			(type dash)
			(color 0 0 132 1)
		)
		(fill
			(type none)
		)
		(uuid "62509534-25bf-433c-8483-ea2795eea1d8")
	)
	(text "SPI1 memories FRAM + flash"
		(exclude_from_sim no)
		(at 16.51 54.61 0)
		(effects
			(font
				(size 1 1)
				(bold yes)
				(color 0 0 132 1)
			)
			(justify left top)
		)
		(uuid "7149e435-0e00-401c-864a-9971075c1f9a")
	)
	(text "Bias 10 k from +3V3_A (ratiometric to VREF+), 100 nF per channel; S5 / S6 = 0 V, S7 = 50 % self-check.\nSettle after a channel change: 10 nF / 110 nF share 9 %, τ 0.59 ms → FW waits ≥ 5 ms.\nLeakage (7 × 25 + 45 nA) × 5 k ≈ 1.1 mV ≈ 0.04 K; +3V3_A load 1.2 mA at 25 °C (budget 1.5 mA).\nMUX_S0..2 100 k PD / MUX_INH 100 k PU: defined while U802 ports are inputs (POR / reset)."
		(exclude_from_sim no)
		(at 120.65 111.76 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "bd6d06ec-d319-4d45-a4c0-12b1aa9647d6")
	)
	(rectangle
		(start 118.11 53.34)
		(end 361.95 127)
