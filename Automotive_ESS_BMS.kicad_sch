			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "cffe743c-defa-4af2-bb1b-99903749809b")
	)
	(text "MASTER BMS SYSTEM ARCHITECTURE & INTER-MODULE BUS MAP\nAutomotive ASIL-C & ESS 7S-16S Dual Chemistry (LFP / NMC) Configurable"
