		(title "Automotive & ESS 7S-16S BMS - Master System Hierarchy")
		(date "2026-10-27")
		(rev "v1.0")
		(company "NextGen Automotive Energy Storage Solutions")
		(comment 1 "Universal LiFePO4 (LFP) / NMC Dual-Chemistry Architecture (16V - 72V Continuous, 100V Transient)")
		(comment 2 "Automotive ISO 26262 ASIL-C Ready & ISO 16750-2 / ISO 7637-2 / ISO 10605 Transient Compliant")
		(comment 3 "Galvanically Isolated CAN-FD & RS-485 Modbus Telemetry to Energy Management System & Inverter")
		(comment 4 "Sheet 1/7: Master Architectural Hierarchy & Subsystem Interconnect Map")
	)
	(lib_symbols)
	(text "AUTOMOTIVE & ENERGY STORAGE SYSTEM (ESS) 7S-16S CONFIGURABLE BMS\nEngineered for Tier-1 Commercial Energy Storage & Light Electric Vehicle (LEV) Applications\n---------------------------------------------------------------------------------------\nKey Architectural Features:\n - Wide Input Voltage Operating Range: 16V to 72V continuous (100V peak load dump)\n - Dual Chemistry Support: LiFePO4 (3.2V nom, 3.65V max) & NMC/Li-Ion (3.7V nom, 4.2V max)\n - Series Cell Count: Dynamically selectable from 7S up to 16S via hardware DIP switch / EEPROM\n - 3000Vrms Galvanic Isolation Barrier separating Pack High-Voltage from External CAN-FD & RS-485\n - Sub-Microsecond Hardware Analog Over-Current Fast Trip (<4.5ns response time)\n - 100% Surface Mount Technology (SMT) optimized for JLCPCB 4-Layer standard fabrication"
		(exclude_from_sim no)
		(at 25.4 180 0)
