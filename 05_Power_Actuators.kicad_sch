	)
	(text "J_PRE1 pin 1 -> pin 2: no on-board link.\nR_PRE1 50R from NET_PRE_IN to the bus.\nPeak at 72 V: 1.44 A, 104 W (calc).\ntau = 50R x C_bus (C_bus off-board)."
		(exclude_from_sim no)
		(at 237.49 106.68 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "52fc2507-bf24-4e9c-ad46-b1676938aa23")
	)
	(text "Low-side switch: CTRL high -> Q on -> coil energised, LED on.\nR_GS 47k holds Q off while the MCU pin floats; D_Z 18 V clamps the gate.\nD_FLY SS34 returns the coil flyback current to +12V.\nQ symbol pins D/G/S vs SOT-23 pads 1/2/3: open owner question."
		(exclude_from_sim no)
		(at 68.58 212.09 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "82612b27-ead5-4751-986e-7e7f5a591b88")
	)
	(text "V_HV_SENSE = bus x 20.0k / 2.02M = bus / 101 (calc).\n72 V bus -> 0.713 V at the ADC (calc).\nC_HV1 10nF with 19.8k: fc = 0.80 kHz (calc).\nR_HV_BOT1 0.1% value vs 1% MPN: owner question."
		(exclude_from_sim no)
		(at 289.56 106.68 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "a921c708-1eeb-4e61-a2f8-e66816bd123b")
	)
	(text "CONTACTOR DRIVERS - Q_POS1, Q_NEG1, Q_PRE1 SQ2318EY (12 V coils)"
